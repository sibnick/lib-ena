spec: v0.6

name: ena-ci-app

unikraft: stable

libraries:
  lib-ena:
    source: ../..
    version: ">=0.1.0"
    kconfig:
      CONFIG_LIBENA: "y"
      CONFIG_LIBENA_LLQ: "y"
      CONFIG_LIBENA_MSIX: "n"
      CONFIG_LIBUKPRINT_KLVL_INFO: "y"

targets:
  - name: kvm
    plat: qemu
    arch: x86_64
  # No arm64 target. The driver needs x86 port I/O today. Ticket 658166ee81
  # tracks the ECAM path that makes an arm64 target possible.
