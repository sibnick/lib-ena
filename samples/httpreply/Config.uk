config APPHTTPREPLY_DEPENDENCIES
	bool
	default y
	select LIBNOLIBC if !HAVE_LIBC
	select LIBUKALLOC
	select LIBUKBUS
	select LIBUKBUS_PCI
	select LIBUKNETDEV
	select LIBLWIP
	select LIBLWIP_IPV4
	select LIBLWIP_NOTHREADS
	select LIBLWIP_SOCKET
	select LIBLWIP_DHCP
	select LIBLWIP_TCP
	select LIBPOSIX_POLL
	select LIBPOSIX_SOCKET_POLLED
	select LIBPOSIX_TIME
	select LIBENA

menuconfig APPHTTPREPLY
	bool "Unikraft HTTP Reply Benchmark Server"
	default y
	select APPHTTPREPLY_DEPENDENCIES
