spec: v0.6

name: httpreply-ena
version: 0.1.0
description: Official Unikraft HTTP reply benchmark server with native AWS ENA driver

unikraft:
  version: stable

targets:
  - name: aws-t3-x86_64
    architecture: x86_64
    platform: kvm

libraries:
  lwip:
    version: stable
    kconfig:
      - CONFIG_LWIP_IPV4=y
      - CONFIG_LWIP_SOCKET=y
      - CONFIG_LWIP_DHCP=y
      - CONFIG_LWIP_TCP=y
  ena:
    source: ../..
    version: main
    kconfig:
      - CONFIG_LIBENA=y
      - CONFIG_LIBENA_LLQ=y
