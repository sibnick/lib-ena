# QEMU local-verification build of httpreply-mc. QEMU has no ENA
# device, so this variant runs the app on virtio-net (already linked
# in the base build) with user-mode networking. One vCPU, one queue
# pair, and the same 8080 listener as the defconfig. Used by
# scripts/qemu_tfb.sh together with scripts/build_disk.sh.
# [Ticket 2212657476]
#
# Build recipe: the Kconfig merge keeps the full expanded values from
# the previous .config, so do not copy this short file straight into
# .config. Start from the full expanded .config and set the values
# this variant changes:
#   CONFIG_UKPLAT_CPU_MAXCOUNT=1
#   CONFIG_LIBUKNETDEV_MAXNBQUEUES=1
#   CONFIG_LWIP_NUM_TCPCON=8192
#   CONFIG_LIBPOSIX_FDTAB_MAXFDS=8192
# Then run make all. Keep lib-ena selected: the app Config.uk selects
# it, and the ENA driver stays idle under QEMU because no ENA PCI
# device (1d0f) is present.

CONFIG_ARCH_X86_64=y
CONFIG_PLAT_KVM=y
CONFIG_KVM_PCI=y
CONFIG_UKPLAT_CPU_MAXCOUNT=1
CONFIG_HAVE_SMP=y
CONFIG_LIBNOLIBC=y
CONFIG_LIBUKALLOC=y
CONFIG_LIBUKALLOCBBSID=y
CONFIG_LIBUKBUS=y
CONFIG_LIBUKBUS_PCI=y
CONFIG_LIBUKINTCTLR_APIC=y
CONFIG_LIBUKNETDEV=y
CONFIG_LIBUKNETDEV_MAXNBQUEUES=1
CONFIG_LIBUKSCHED=y
CONFIG_LIBUKSCHEDCOOP=y
CONFIG_LIBUKLOCK=y
CONFIG_LIBUKLOCK_SEMAPHORE=y
CONFIG_LIBUKLOCK_MUTEX=y
CONFIG_LIBUKMPI=y
CONFIG_LIBUKMPI_MBOX=y
CONFIG_LIBUKBOOT=y
CONFIG_LIBUKBOOT_PERCORE_HEAP=y
CONFIG_LIBUKBOOT_MAINTHREAD=y
CONFIG_LIBUKPCPUVAR=y
CONFIG_LIBLWIP=y
CONFIG_LWIP_IPV4=y
CONFIG_LWIP_TCP=y
CONFIG_LWIP_NOTHREADS=y
CONFIG_LWIP_PERCORE=y
CONFIG_LWIP_SOCKET=y
CONFIG_LWIP_DHCP=y
CONFIG_LWIP_AUTOIFACE=y
# Sized so a local QEMU run can hold a c=4096 connection set on one
# core with headroom. [Ticket 68b37524bb]
CONFIG_LWIP_NUM_TCPCON=8192
CONFIG_LWIP_NUM_TCPLISTENERS=256
CONFIG_LWIP_WND_SCALE=y
CONFIG_LWIP_RCVBUF=y
CONFIG_LWIP_POOLS=y
CONFIG_LIBPOSIX_POLL=y
CONFIG_LIBPOSIX_SOCKET=y
CONFIG_LIBPOSIX_SOCKET_POLLED=y
CONFIG_LIBPOSIX_TIME=y
CONFIG_LIBPOSIX_FDTAB_MAXFDS=8192

# virtio-net replaces ENA under QEMU.
CONFIG_LIBVIRTIO_BUS=y
CONFIG_LIBVIRTIO_RING=y
CONFIG_LIBVIRTIO_PCI=y
CONFIG_LIBVIRTIO_NET=y

CONFIG_LIBUKPRINT_KLVL_INFO=y
CONFIG_APPHTTPREPLYMC=y
CONFIG_APPHTTPREPLYMC_LISTEN_PORT=8080
CONFIG_APPHTTPREPLYMC_CONSOLE_STATS=n

CONFIG_OPTIMIZE_PERF=y
CONFIG_OPTIMIZE_LTO=y