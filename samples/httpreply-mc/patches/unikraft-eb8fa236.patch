-						    eax, edx);
-	}
+	__u32 eax, edx;
+
+	uk_arch_x86_64_rdmsr(UK_ARCH_X86_64_APIC_MSR_BASE, &eax, &edx);
+
+	/* MMIO base is bits 35:12 of the base MSR; default is 0xFEE00000 */
+	apic_mmio_base = (((__u64)edx << 32) | (__u64)eax) & 0xFFFFF000UL;
+	if (!apic_mmio_base)
