+
+	/* Set EN (bit 11) and clear EXTD (bit 10) */
+	eax |= UK_ARCH_X86_64_APIC_BASE_EN;
+	eax &= ~UK_ARCH_X86_64_APIC_BASE_EXTD;
+	uk_arch_x86_64_wrmsr(UK_ARCH_X86_64_APIC_MSR_BASE, eax, edx);
 
