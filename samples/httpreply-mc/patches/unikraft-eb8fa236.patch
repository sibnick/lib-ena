-					    &eax, &edx);
-	if (!(eax & UK_ARCH_X86_64_APIC_BASE_EN))
-		return -ENOTSUP;
-
-	/* Switch to x2APIC mode */
-	eax |= UK_ARCH_X86_64_APIC_BASE_EXTD;
-	uk_arch_x86_64_wrmsr(UK_ARCH_X86_64_APIC_MSR_BASE,
-					    eax, edx);
-
-	/* Set APIC software enable flag if necessary */
