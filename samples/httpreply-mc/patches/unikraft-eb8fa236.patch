+#if CONFIG_LIBUKBOOT_PERCORE_HEAP
+	/* Reserve one region per non-boot core before the default
+	 * allocator claims the remaining free regions.
+	 */
+	percore_heap_init();
+#endif /* CONFIG_LIBUKBOOT_PERCORE_HEAP */
+
