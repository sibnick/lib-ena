config APPHTTPREPLYMC_DEPENDENCIES
	bool
	default y
	select LIBNOLIBC if !HAVE_LIBC
	select LIBUKALLOC
	select LIBUKBUS
	select LIBUKBUS_PCI
	select LIBUKNETDEV
	select LIBUKSCHED
	select LIBUKSCHEDCOOP
	select LIBUKLOCK
	select LIBUKLOCK_SEMAPHORE
	select LIBUKLOCK_MUTEX
	select LIBUKMPI
	select LIBUKMPI_MBOX
	select LIBUKBOOT
	select LIBUKPCPUVAR
	select LIBLWIP
	select LIBLWIP_IPV4
	select LIBLWIP_NOTHREADS
	select LIBLWIP_PERCORE
	select LIBLWIP_SOCKET
	select LIBLWIP_DHCP
	select LIBLWIP_TCP
	select LIBPOSIX_POLL
	select LIBPOSIX_SOCKET_POLLED
	select LIBPOSIX_TIME
	select LIBENA

menuconfig APPHTTPREPLYMC
	bool "Unikraft HTTP Reply Multi-Core Benchmark Server"
	default n
	select APPHTTPREPLYMC_DEPENDENCIES

config APPHTTPREPLYMC_CONSOLE_STATS
	bool "Print periodic heartbeat and stats to the console"
	depends on APPHTTPREPLYMC
	default n
	help
	  Print the 2 s per-core heartbeat, the per-request stats line, and
	  the lwIP stall probe to the console. Each write blocks the
	  run-to-completion worker loop, so the whole core stops and every
	  open connection waits. This inflates tail latency. Keep this off
	  for latency benchmarks. Turn it on only for bring-up and
	  debugging.

config APPHTTPREPLYMC_NETLOG
	bool "Mirror all console output to a ring and serve it at /__log"
	depends on APPHTTPREPLYMC
	default n
	help
	  Register a stdout console device that copies every log line into
	  an in-memory ring, and answer GET /__log on the listen port with
	  the last bytes of that ring. The EC2 serial console is lossy and
	  lags, so this gives a reliable way to read the bbuddy free-path
	  guard and the fd-lock warnings during a run. Adds one compare per
	  request and a copy per log line. Keep this off for clean latency
	  numbers; use it only to localize faults. [Ticket a9c6945c21]

config APPHTTPREPLYMC_NETLOG_SIZE
	hex "Netlog ring size (power of two)"
	depends on APPHTTPREPLYMC_NETLOG
	default 0x40000
	help
	  Size in bytes of the in-memory log ring. Must be a power of two.
	  The /__log endpoint returns the most recent bytes up to this size.
