{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "clangd": {
      "disabled": false,
      "command": [
        "clangd",
        "--background-index",
        "--compile-commands-dir=build"
      ]
    }
  },
  "providers": {
    "strata": {
      "package": "@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://host.containers.internal:8080/v1"
      }
    }
  }
}

