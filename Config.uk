menuconfig LIBENA
	bool "ena: AWS Elastic Network Adapter (ENA) native driver"
	# The driver reads PCI config space with x86 port I/O on ports
	# 0xCF8 and 0xCFC, so it builds only for x86_64. Ticket 658166ee81
	# tracks the ECAM path that removes this guard.
	depends on ARCH_X86_64
	default n
	select LIBUKALLOC
	select LIBUKBUS_PCI
	select LIBUKNETDEV

if LIBENA
config LIBENA_LLQ
	bool "Enable Low Latency Queue (LLQ) push mode"
	default y
	help
	  Enables direct MMIO push of TX descriptors and packet headers
	  on supported AWS EC2 instance types.

config LIBENA_MAX_QUEUES
	int "Maximum IO Queues per Device"
	default 8
	help
	  Maximum number of TX and RX queue pairs allocated per device.

config LIBENA_RSS
	bool "Hardware Receive Side Scaling (RSS)"
	default y
	help
	  Distribute incoming packets across multiple hardware RX queues
	  using Toeplitz hash on TCP/IPv4 headers. When disabled, all
	  packets arrive on RX Queue 0.

config LIBENA_MSIX
	bool "Arm the MSI-X capability (hardware interrupts)"
	default y
	help
	  Arm the device MSI-X capability so the unikernel gets
	  hardware interrupts. When off, the driver skips arming and
	  runs in software polling mode. Bisect toggle for interrupt
	  bring-up.

config LIBENA_MSIX_LCPU_LIST
	string "lcpu target list for IO queue MSI-X vectors"
	depends on LIBENA_MSIX
	default ""
	help
	  Target the completion interrupt of each IO queue pair at one
	  lcpu from this list. The list is a comma-separated set of
	  lcpu numbers, for example "0,1". Queue q takes entry q. The
	  driver cycles a list that is shorter than the negotiated
	  queue count. Use this to keep queue interrupts on N real
	  cores while the kernel boots 2N hyperthreads. The queue
	  count itself comes from CONFIG_LIBENA_MAX_QUEUES and the
	  device negotiation. Leave the value empty (default) to
	  target queue q at lcpu q % booted CPU count, as before. The
	  Admin/AENQ vector always targets lcpu 0. A malformed value
	  logs a warning and falls back to the modulo rule. Entry
	  values must stay below the booted CPU count.
	  [Ticket 344310cd80]

config LIBENA_VERBOSE_STATS
	bool "ena: periodic per-queue datapath stats print"
	default n
	help
	  Print the per-queue TX and RX packet and byte counters to the
	  console every N received packets. This verifies that traffic is
	  spread over all ENA queue pairs. Off by default.
endif
